{
  "name": "qqurz-chess",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "check:css": "node scripts/check-css-architecture.mjs",
    "check:ui": "node scripts/check-controls.mjs",
    "check:pieces": "node scripts/check-piece-system.mjs",
    "check:clock": "node scripts/check-clock-system.mjs",
    "prepare:engine": "node scripts/copy-stockfish.mjs",
    "prepare:quarter": "node scripts/fetch-quarter-assets.mjs",
    "dev": "npm run check:css && npm run check:ui && npm run check:pieces && npm run check:clock && npm run prepare:engine && npm run prepare:quarter && vite",
    "build": "npm run check:css && npm run check:ui && npm run check:pieces && npm run check:clock && npm run prepare:engine && npm run prepare:quarter && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lichess-org/chessground": "10.1.1",
    "chessops": "0.15.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "stockfish": "18.0.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "@types/three": "0.185.4"
  }
}
