diff --git a/scripts/check-error-monitoring.mjs b/scripts/check-error-monitoring.mjs
new file mode 100644
index 0000000..c8dccb5
--- /dev/null
+++ b/scripts/check-error-monitoring.mjs
@@ -0,0 +1,43 @@
+import fs from 'node:fs';
+
+const read = path => fs.readFileSync(path, 'utf8');
+const errors = [];
+const monitor = read('src/monitoring/errorMonitor.ts');
+const main = read('src/main.tsx');
+const socket = read('src/multiplayer/client.ts');
+const stockfish = read('src/engine/stockfish.ts');
+const webgl = read('src/premium/ThreeBoardRenderer.tsx');
+const tournamentClient = read('src/tournaments/engineClient.ts');
+const paymentClient = read('src/tournaments/client.ts');
+const ops = read('server/src/data/operations.ts');
+const migrations = read('server/src/data/migrations.ts');
+const gateway = read('server/src/modules/realtime/index.ts');
+const payments = read('server/src/modules/payments/index.ts');
+const tournament = read('server/src/modules/tournament/index.ts');
+const pages = read('.github/workflows/deploy-pages.yml');
+const realtime = read('.github/workflows/deploy-realtime.yml');
+
+for (const marker of ['unhandledrejection', "window.addEventListener('error'", "credentials: 'omit'", "referrerPolicy: 'no-referrer'", 'VITE_RELEASE_ID', 'VITE_APP_VERSION']) {
+  if (!monitor.includes(marker)) errors.push(`Client crash monitor is missing ${marker}.`);
+}
+if (monitor.includes('accountToken') || monitor.includes('qqurz:profile')) errors.push('Crash monitor must not attach account identity.');
+if (!main.includes('installCrashMonitoring()')) errors.push('Crash monitor is not installed at app bootstrap.');
+if (!socket.includes("kind: 'websocket_failure'")) errors.push('WebSocket failure reporting is missing.');
+if (!stockfish.includes("kind: 'stockfish_crash'") || !stockfish.includes("kind: 'stockfish_timeout'")) errors.push('Stockfish crash/timeout reporting is incomplete.');
+if (!webgl.includes('webglcontextlost') || !webgl.includes("kind: 'webgl_context_lost'")) errors.push('WebGL context-loss reporting is missing.');
+if (!tournamentClient.includes("kind: 'tournament_engine_error'")) errors.push('Tournament client error reporting is missing.');
+if (!paymentClient.includes("kind: 'payment_failure'")) errors.push('Payment client error reporting is missing.');
+for (const marker of ['operational_errors', 'occurrence_count', 'release_id', '/monitoring/client-error']) if (!ops.includes(marker) && !migrations.includes(marker)) errors.push(`Persistent operational error model is missing ${marker}.`);
+for (const marker of ['recordOperationalError', 'unhandled_exception', 'x-qqurz-release', 'x-qqurz-version']) if (!gateway.includes(marker)) errors.push(`Backend exception boundary is missing ${marker}.`);
+if (!payments.includes('provider_webhook_failed') || !payments.includes('webhook_exception')) errors.push('Payment/webhook monitoring is incomplete.');
+if (!tournament.includes('tournament_engine_exception') || !tournament.includes('tournament_engine_response')) errors.push('Tournament backend monitoring is incomplete.');
+if (!pages.includes('VITE_RELEASE_ID: ${{ github.sha }}')) errors.push('Pages build is not stamped with the Git commit release ID.');
+if (!realtime.includes('Stamp Worker release') || !realtime.includes('GITHUB_SHA')) errors.push('Worker deployment is not stamped with the Git commit release ID.');
+
+if (errors.length) {
+  console.error('\nQQURZ crash/error monitoring check failed:\n');
+  for (const error of errors) console.error(` - ${error}`);
+  console.error('');
+  process.exit(1);
+}
+console.log('QQURZ crash/error monitoring OK: frontend, WebSocket, Stockfish, WebGL, payments/webhooks, tournament engine and backend exceptions are release-tagged and privacy-scrubbed.');
